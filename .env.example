# Backend
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=local

# PostgreSQL
POSTGRES_DB=chain_stories
POSTGRES_USER=chain_stories
POSTGRES_PASSWORD=chain_stories_dev
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/chain_stories
SPRING_DATASOURCE_USERNAME=chain_stories
SPRING_DATASOURCE_PASSWORD=chain_stories_dev

# Redis
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# Security
JWT_ISSUER=chain-stories-local
JWT_SECRET=replace-with-local-development-secret
JWT_ALLOW_INSECURE_DEV_SECRET=true
JWT_ACCESS_TOKEN_TTL_MINUTES=15
JWT_REFRESH_TOKEN_TTL_DAYS=30
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Subscriptions
SUBSCRIPTIONS_MOCK_PURCHASES_ENABLED=false

# AI provider
AI_PROVIDER=mock
AI_MOCK_MODEL=mock-story-v1
AI_GENERATION_MAX_ATTEMPTS=3
OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4.1-mini
AI_OPENAI_BASE_URL=https://api.openai.com
AI_OPENAI_CONNECT_TIMEOUT=3s
AI_OPENAI_READ_TIMEOUT=15s
AI_API_KEY=
